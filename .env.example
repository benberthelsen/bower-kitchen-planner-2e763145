# Optional public feature controls. Features default to enabled.
VITE_FEATURE_AI_DESIGNER=true
VITE_FEATURE_ROOM_SCANNER=true
VITE_FEATURE_ANDROID_AR=true
VITE_FEATURE_IOS_AR=true
# The browser never fetches from the private scanner Site. The
# scanner-private-bridge Edge function reads the server-side secrets
# SCANNER_ORIGIN, PLANNER_ORIGIN and SCANNER_SITES_ACCESS_TOKEN instead.
# Optional: the scanner origin (https, no path) so admin accounts get
# "Scan a room with your phone" links in trade jobs. The scanner only admits
# its owner, so leave this unset in builds for other users.
# VITE_ROOM_SCANNER_URL=https://your-private-scanner-site.example

# Supabase Edge Function secret (set server-side, never expose as VITE_*).
# AI_DESIGNER_ENABLED=true

# Supabase Edge Function secrets (server-side only) for durable Build Flow
# pipeline delivery from homeowner and trade submissions.
BUILDFLOW_LEAD_INTAKE_URL=https://cfwywsrhwnfqzdxcgnmm.supabase.co/functions/v1/bf-lead-intake
BUILDFLOW_INTAKE_SECRET=
